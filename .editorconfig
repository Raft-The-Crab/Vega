# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Code files
[*.{cs,rs,kt,ts,tsx,js,jsx,json,xml,yml,yaml}]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# C# files
[*.cs]
indent_size = 4

# Rust files
[*.rs]
indent_size = 4

# Kotlin files
[*.kt]
indent_size = 4
continuation_indent_size = 4

# TypeScript/JavaScript files
[*.{ts,tsx,js,jsx}]
indent_size = 2

# JSON/XML files
[*.{json,xml,yml,yaml}]
indent_size = 2

# CMake files
[CMakeLists.txt]
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf
